# Epsilon — .gitignore

# Archivos de sistema
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Node
node_modules/

# Python
__pycache__/
*.pyc
*.pyo
.env
.venv/

# Build / producción
dist/
build/

# Archivos temporales
tmp/
temp/

# PDFs generados (si los generamos para el blog)
*.pdf

# Carpeta de cache de screenshots (Hermes)
.cache/

# Archivos que no queremos en prod
*.bak
*.orig
